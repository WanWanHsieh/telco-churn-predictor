{
  "name": "churn-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "vue-tsc --build",
    "test": "vitest",
    "gen:api": "openapi-typescript ../contracts/openapi.json -o src/api/schema.gen.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "chart.js": "4.6.1",
    "element-plus": "2.14.8",
    "pinia": "4.1.0",
    "vue": "3.5.46",
    "vue-chartjs": "5.3.7",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.6.0",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  }
}
