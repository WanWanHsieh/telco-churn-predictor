# 本專案沒有任何機密；全部變數皆有預設值，不建立 .env 也能 docker compose up。
# 複製為 .env 後可覆寫（.env 已被 .gitignore 排除）。

# --- backend ---
# development 時 log 改為人類可讀格式
APP_ENV=production
LOG_LEVEL=INFO
# 模型產物目錄（容器內為 /app/models）
MODEL_DIR=./models
# 逗號分隔；不允許 *（NFR-8）
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8080
# 啟動時驗證 0 < medium < high < 1，否則拒絕啟動
RISK_MEDIUM_THRESHOLD=0.30
RISK_HIGH_THRESHOLD=0.60
BATCH_MAX_FILE_BYTES=5242880
BATCH_MAX_ROWS=10000
# IG 積分步數，範圍 16–256
IG_STEPS=64

# --- docker compose（對外埠）---
BACKEND_PORT=8000
FRONTEND_PORT=8080

# --- frontend（建置期）---
VITE_API_BASE_URL=/api/v1
VITE_API_DOCS_URL=/docs
